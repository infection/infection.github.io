# Pin this repo to the public npm registry.
#
# Without this, `npm install` inherits whatever `registry=` a contributor has in
# their global ~/.npmrc (e.g. a corporate Artifactory mirror) and bakes that host
# into package-lock.json's `resolved` URLs. CI then gets E401 on every tarball
# because it has no credentials for that host.
registry=https://registry.npmjs.org/
